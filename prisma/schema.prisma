generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  MANAGER
  TECHNICIAN
  VIEWER
}

enum AssetStatus {
  OPERATIONAL
  UNDER_MAINTENANCE
  DEGRADED
  DECOMMISSIONED
  IN_STORAGE
}

enum LifecycleStage {
  PLANNED
  ACQUIRED
  INSTALLED
  OPERATIONAL
  MAINTAINED
  RETIRED
  DISPOSED
}

enum WorkOrderStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  WAITING_PARTS
  WAITING_VENDOR
  WAITING_APPROVAL
  COMPLETED
  CLOSED
}

enum PartRequestStatus {
  REQUESTED
  APPROVED
  ISSUED
  CONSUMED
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum VendorType {
  ASSET_VENDOR
  PARTS_VENDOR
  SERVICE_PROVIDER
}

enum CriticalityClassification {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ScheduleType {
  WEEKLY
  MONTHLY
  ANNUAL
  CUSTOM_RECURRING
}

// ==========================================
// USER & ORGANIZATION
// ==========================================

/// Organizations represent the top-level tenant in a B2B SaaS or a major business entity.
model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  sites Site[]
}

/// Users represent individuals accessing the system.
model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String   @unique
  name           String
  role           Role     @default(VIEWER)
  passwordHash   String?  @default("$2b$10$T1K.sQz7L1F8gW/y1eQ9Ue.b1nF.hJ1L8M/W6Qz7L1F8gW/y1eQ9Ue") /// Mock default password hash for existing users
  organizationId String   @db.Uuid
  siteId         String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  assetHistories     AssetHistory[]   @relation("PerformedBy")
  riskAssessments    RiskAssessment[] @relation("AssessedBy")
  notifications      Notification[]   @relation("UserNotifications")
  auditLogs          AuditLog[]       @relation("UserAuditLogs")

  requestedParts     WorkOrderPart[]  @relation("RequestedParts")
  issuedParts        WorkOrderPart[]  @relation("IssuedParts")

  @@index([organizationId])
  @@index([email])
}

// ==========================================
// TECHNICIAN MANAGEMENT
// ==========================================

/// Technicians represent maintenance personnel or contractors.
model Technician {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  technicianCode String   @unique /// Auto-generated ID, e.g. TECH-1001
  employeeNumber String?
  name           String
  role           String   /// e.g. Mechanical Technician, Electrical Technician
  email          String   @unique
  phone          String?
  skills         String?  /// Comma separated list of skills/certifications
  status         String   @default("Active") /// Active, Inactive, On Leave
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  assignedWorkOrders WorkOrder[]      @relation("AssignedTechnician")
  maintenanceProgs   MaintenanceProgram[]
}

// ==========================================
// SITE STRUCTURE
// ==========================================

/// Sites represent physical locations, plants, or facilities.
model Site {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  location       String?
  organizationId String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  users          User[]
  assets         Asset[]
  workOrders     WorkOrder[]
  inventoryParts InventoryPart[]

  @@index([organizationId])
}

// ==========================================
// ASSET MANAGEMENT
// ==========================================

/// Assets represent physical equipment (e.g., HVAC, Generator). Supports parent-child hierarchy.
model Asset {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String         @unique /// Unique identifier for the asset (e.g., GEN-303)
  name             String
  categoryId       String?        @db.Uuid
  status           AssetStatus    @default(OPERATIONAL)
  lifecycleStage   LifecycleStage @default(OPERATIONAL)
  isDeleted        Boolean        @default(false)

  imageUrl         String?
  manufacturer     String?
  modelNumber      String?
  serialNumber     String?
  installationDate DateTime?
  parentId String? @db.Uuid /// Self-referencing foreign key for hierarchy
  siteId   String  @db.Uuid
  vendorId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Asset?  @relation("AssetHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Asset[] @relation("AssetHierarchy")

  site     Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  category AssetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendor   Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  documents          AssetDocument[]
  histories          AssetHistory[]
  maintenanceProgs   MaintenanceProgram[]
  workOrders         WorkOrder[]
  riskAssessments    RiskAssessment[]
  failureEvents      FailureEvent[]
  criticality        AssetCriticality?
  reliabilityMetrics ReliabilityMetric[]

  @@index([siteId])
  @@index([parentId])
  @@index([code])
}

/// Asset Categories group similar assets (e.g., HVAC, Rolling Stock).
model AssetCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  assets Asset[]
}

/// Documents associated with an Asset (e.g., Manuals, Schematics).
model AssetDocument {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  url       String
  assetId   String   @db.Uuid
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}

/// Asset Criticality tracks the multi-dimensional impact of asset failure.
model AssetCriticality {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId             String                    @unique @db.Uuid
  safetyImpact        Int                       @default(1)
  environmentalImpact Int                       @default(1)
  productionImpact    Int                       @default(1)
  financialImpact     Int                       @default(1)
  overallScore        Int                       @default(1)
  classification      CriticalityClassification @default(LOW)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

/// History tracks events, transfers, or status changes of an Asset.
model AssetHistory {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId       String   @db.Uuid
  action        String /// e.g., STATUS_CHANGE, RELOCATED
  description   String?
  performedById String?  @db.Uuid
  createdAt     DateTime @default(now())

  asset       Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  performedBy User? @relation("PerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([assetId])
}

// ==========================================
// MAINTENANCE MANAGEMENT
// ==========================================

/// Maintenance Programs define recurring, preventive maintenance schedules.
model MaintenanceProgram {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  description   String?
  frequencyDays Int /// How often this program generates a Work Order (in days)
  scheduleType  ScheduleType @default(MONTHLY)
  nextDueDate   DateTime?
  
  workType      String?  /// Preventive Maintenance, Inspection, etc.
  priority      WorkOrderPriority @default(MEDIUM)
  
  assetId       String   @db.Uuid
  technicianId  String?  @db.Uuid
  
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  asset      Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  technician Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  workOrders WorkOrder[]

  @@index([assetId])
}

/// Work Orders represent actual maintenance tasks (preventive or reactive).
model WorkOrder {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  woNumber         String            @unique @default(dbgenerated("gen_random_uuid()")) /// Will be overridden via API to WO-XXXXX
  title            String
  description      String?
  status           WorkOrderStatus   @default(DRAFT)
  priority         WorkOrderPriority @default(MEDIUM)
  workType         String?           /// Preventive, Corrective, Breakdown, etc.
  dueDate          DateTime?
  
  estimatedHours   Float?
  actualHours      Float?
  completionNotes  String?
  failureCause     String?
  rootCause        String?

  assetId              String  @db.Uuid
  maintenanceProgramId String? @db.Uuid /// If generated by a preventive program
  assignedToId         String? @db.Uuid
  siteId               String  @db.Uuid

  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset              Asset               @relation(fields: [assetId], references: [id], onDelete: Restrict)
  maintenanceProgram MaintenanceProgram? @relation(fields: [maintenanceProgramId], references: [id], onDelete: SetNull)
  assignedTo         Technician?         @relation("AssignedTechnician", fields: [assignedToId], references: [id], onDelete: SetNull)
  site               Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)

  partsConsumed  WorkOrderPart[]
  failureEvents  FailureEvent[]

  @@index([assetId])
  @@index([siteId])
  @@index([assignedToId])
}

// ==========================================
// INVENTORY MANAGEMENT
// ==========================================

/// Inventory Parts are spare parts or materials kept in stock.
model InventoryPart {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String  @unique
  name           String
  description    String?
  categoryId     String? @db.Uuid
  isDeleted      Boolean @default(false)
  quantityOnHand Int     @default(0)
  minStockLevel  Int     @default(0)
  reorderLevel   Int     @default(0)
  cost           Float   @default(0.0)

  siteId   String  @db.Uuid
  vendorId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site     Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  vendor   Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  category PartCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  workOrderParts WorkOrderPart[]

  @@index([siteId])
  @@index([categoryId])
}

// ==========================================
// PART CATEGORY
// ==========================================

model PartCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  parts       InventoryPart[]
}

/// Work Order Parts track the request, issue, and consumption of parts for specific tasks (Many-to-Many).
model WorkOrderPart {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderId      String   @db.Uuid
  inventoryPartId  String   @db.Uuid
  
  requestedQty     Int      @default(1)
  issuedQty        Int      @default(0)
  quantityConsumed Int      @default(0) // Acts as consumedQty
  
  requestStatus    PartRequestStatus @default(REQUESTED)
  
  requestedAt      DateTime @default(now())
  issuedAt         DateTime?
  consumedAt       DateTime?
  
  requestedById    String?  @db.Uuid
  issuedById       String?  @db.Uuid
  
  createdAt        DateTime @default(now())

  workOrder     WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inventoryPart InventoryPart @relation(fields: [inventoryPartId], references: [id], onDelete: Restrict)
  requestedBy   User?         @relation("RequestedParts", fields: [requestedById], references: [id], onDelete: SetNull)
  issuedBy      User?         @relation("IssuedParts", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([workOrderId])
  @@index([inventoryPartId])
  @@index([requestStatus])
}

// ==========================================
// VENDOR MANAGEMENT
// ==========================================

/// Vendors supply assets, parts, or services.
model Vendor {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  contactName String?
  email       String?
  phone       String?
  type        VendorType @default(PARTS_VENDOR)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  assets         Asset[]
  inventoryParts InventoryPart[]
}

// ==========================================
// RISK MANAGEMENT
// ==========================================

/// Risk Assessments track the probability and impact of asset failure.
model RiskAssessment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId        String   @db.Uuid
  probability    Int /// 1 (Rare) to 5 (Almost Certain)
  impact         Int /// 1 (Negligible) to 5 (Catastrophic)
  riskScore      Int /// probability * impact
  mitigationPlan String?
  assessedById   String?  @db.Uuid
  assessedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  asset      Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assessedBy User? @relation("AssessedBy", fields: [assessedById], references: [id], onDelete: SetNull)

  @@index([assetId])
}

// ==========================================
// RELIABILITY MANAGEMENT
// ==========================================

/// Failure Events record unexpected breakdowns or incidents.
model FailureEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId       String    @db.Uuid
  workOrderId   String?   @db.Uuid
  description   String
  occurredAt    DateTime  @default(now())
  resolvedAt    DateTime?
  downtimeHours Float?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  asset         Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  workOrder     WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([workOrderId])
}

// ==========================================
// RELIABILITY METRIC
// ==========================================

model ReliabilityMetric {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId      String   @db.Uuid
  mtbf         Float?
  mttr         Float?
  availability Float?
  downtime     Float?
  recordedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([recordedAt])
}

// ==========================================
// STRATEGIC ASSET MANAGEMENT PLAN (ISO 55001)
// ==========================================

/// Strategic targets established for a specific financial year.
model StrategicTarget {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fiscalYear            String   @unique /// e.g., "FY 2026"
  availabilityTarget    Float    @default(95.0)
  downtimeTarget        Float    @default(10.0)
  maintenanceCostTarget Float    @default(5.0)
  assetHealthTarget     Float    @default(80.0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ==========================================
// SYSTEM & AUDIT
// ==========================================

/// Tracks all major changes in the system for compliance (ISO 55001)
model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action    String   /// e.g. "WO_CREATED", "ASSET_UPDATED", "INVENTORY_CONSUMED"
  entity    String   /// e.g. "WorkOrder", "Asset"
  entityId  String   @db.Uuid
  details   String?  /// JSON or text description of changes
  userId    String?  @db.Uuid
  createdAt DateTime @default(now())

  user User? @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityId])
  @@index([userId])
}

/// In-app notification system
model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  message   String
  type      String   /// e.g. "WO_ASSIGNED", "LOW_STOCK", "PM_DUE"
  isRead    Boolean  @default(false)
  userId    String   @db.Uuid
  linkUrl   String?  /// Optional link to the relevant entity
  createdAt DateTime @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
